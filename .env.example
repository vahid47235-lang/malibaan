# Postgres connection string (Vercel Postgres / Neon / Supabase all provide one of these)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random 32+ byte secret used to sign admin session cookies. Generate with:
# openssl rand -hex 32
SESSION_SECRET=

# Optional — set these before the FIRST deploy to choose your own super-admin
# credentials instead of getting a random password printed in the build log.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
